  lines:
  - speakerIcon: {fileID: 0}
    text: "This is it\u2026 the Lab Core."
  - speakerIcon: {fileID: 0}
    text: The original subject. The source of everything.
  - speakerIcon: {fileID: 0}
    text: "Vorrath\u2026 You were never meant to evolve this far."
