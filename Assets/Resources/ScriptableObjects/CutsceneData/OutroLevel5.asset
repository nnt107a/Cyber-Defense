  m_Script: {fileID: 11500000, guid: 0f0270995b78b08499239e6f7c22adc3, type: 3}
  m_Name: OutroLevel5
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  lines:
  - speakerIcon: {fileID: 9184683540041684037, guid: a1bfe8228758dec42960a9220933ffd3, type: 3}
    text: Log Entry #Final.
  - speakerIcon: {fileID: -3358647591155879279, guid: 3cf94bad25a735849818f383972dc6f6, type: 3}
    text: Vorrath has been neutralized. The swarm is gone.
  - speakerIcon: {fileID: 8856822166903049042, guid: 8bb7d48340457b14aab7878f790df828, type: 3}
    text: "The E-Core\u2026 unstable, but contained."
  - speakerIcon: {fileID: 21300000, guid: 42544a43522a672408a0cf8cb5455bec, type: 3}
    text: This facility will never be safe again.
  - speakerIcon: {fileID: 21300000, guid: 42544a43522a672408a0cf8cb5455bec, type: 3}
    text: "But the world outside\u2026 will live."
  - speakerIcon: {fileID: 21300000, guid: 42544a43522a672408a0cf8cb5455bec, type: 3}
    text: For now.
