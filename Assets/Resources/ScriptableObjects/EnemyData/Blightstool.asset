  m_Name: Blightstool
  m_EditorClassIdentifier: Assembly-CSharp::EnemyData
  enemyPrefab: {fileID: 2838149179291942230, guid: 731f1b85c90d24f47a3ece94fe0f411d, type: 3}
  enemyIcon: {fileID: 21300000, guid: cdd403fa7d0be304dbdbb1e76f8ae400, type: 3}
  enemyName: Blighstool
  maxHealth: 150
  moveSpeed: 0.4
  attackDamage: 70
  attackSpeed: 0.75
  physicalResistance: 0.1
  magicalResistance: 0.25
  eCoreDrop: 50
  description: "Blightstool was once a harmless fungal culture engineered to recycle
    biological waste. Exposure to unstable E-Core radiation caused the organism to
    develop neural clusters and aggressive growth patterns. It now spreads by releasing
    corrosive spores that rewrite nearby organic matter. Researchers believe Blightstool
    no longer follows any natural survival instinct\u2014only expansion."
  vnDescription: "Blightstool t\u1EEBng l\xE0 m\u1ED9t lo\u1EA1i n\u1EA5m v\xF4 h\u1EA1i
    \u0111\u01B0\u1EE3c nu\xF4i c\u1EA5y \u0111\u1EC3 t\xE1i ch\u1EBF ch\u1EA5t th\u1EA3i
    sinh h\u1ECDc. Vi\u1EC7c ti\u1EBFp x\xFAc v\u1EDBi b\u1EE9c x\u1EA1 E-Core kh\xF4ng
    \u1ED5n \u0111\u1ECBnh \u0111\xE3 khi\u1EBFn sinh v\u1EADt n\xE0y ph\xE1t tri\u1EC3n
    c\xE1c c\u1EE5m t\u1EBF b\xE0o th\u1EA7n kinh v\xE0 m\xF4 h\xECnh t\u0103ng tr\u01B0\u1EDFng
    m\u1EA1nh m\u1EBD. Gi\u1EDD \u0111\xE2y, n\xF3 l\xE2y lan b\u1EB1ng c\xE1ch gi\u1EA3i
    ph\xF3ng c\xE1c b\xE0o t\u1EED \u0103n m\xF2n l\xE0m bi\u1EBFn \u0111\u1ED5i
    v\u1EADt ch\u1EA5t h\u1EEFu c\u01A1 xung quanh. C\xE1c nh\xE0 nghi\xEAn c\u1EE9u
    tin r\u1EB1ng Blightstool kh\xF4ng c\xF2n tu\xE2n theo b\u1EA5t k\u1EF3 b\u1EA3n
    n\u0103ng sinh t\u1ED3n t\u1EF1 nhi\xEAn n\xE0o n\u1EEFa\u2014m\xE0 ch\u1EC9
    h\u01B0\u1EDBng \u0111\u1EBFn s\u1EF1 b\xE0nh tr\u01B0\u1EDBng."
