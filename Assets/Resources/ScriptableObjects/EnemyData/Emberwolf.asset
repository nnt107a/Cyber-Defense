  m_Script: {fileID: 11500000, guid: 4078eefe2913944458e267c1387e6378, type: 3}
  m_Name: Emberwolf
  m_EditorClassIdentifier: Assembly-CSharp::EnemyData
  enemyPrefab: {fileID: 7679583117026828654, guid: a53c91b71b6c6344087ad7c661f8bef8, type: 3}
  enemyIcon: {fileID: 21300000, guid: 973d3192363c7154bb64ca9963523d43, type: 3}
  enemyName: Emberwolf
  maxHealth: 120
  moveSpeed: 0.8
  attackDamage: 30
  attackSpeed: 1.5
  physicalResistance: 0.25
  magicalResistance: 0.25
  eCoreDrop: 50
  description: "Emberwolf originated from a genetically enhanced security organism
    designed for high-temperature environments. When the containment fields failed,
    its metabolism fused with volatile energy residue from the reactors. The creature\u2019s
    internal heat never dissipates, forcing it into a constant state of aggression.
    What remains resembles neither animal nor machine, but a living furnace driven
    by instinct."
  vnDescription: "Emberwolf c\xF3 ngu\u1ED3n g\u1ED1c t\u1EEB m\u1ED9t sinh v\u1EADt
    an ninh \u0111\u01B0\u1EE3c c\u1EA3i ti\u1EBFn gen, \u0111\u01B0\u1EE3c thi\u1EBFt
    k\u1EBF cho m\xF4i tr\u01B0\u1EDDng nhi\u1EC7t \u0111\u1ED9 cao. Khi tr\u01B0\u1EDDng
    ng\u0103n ch\u1EB7n b\u1ECB l\u1ED7i, qu\xE1 tr\xECnh trao \u0111\u1ED5i ch\u1EA5t
    c\u1EE7a n\xF3 \u0111\xE3 h\xF2a tr\u1ED9n v\u1EDBi c\u1EB7n n\u0103ng l\u01B0\u1EE3ng
    d\u1EC5 bay h\u01A1i t\u1EEB c\xE1c l\xF2 ph\u1EA3n \u1EE9ng. Nhi\u1EC7t l\u01B0\u1EE3ng
    b\xEAn trong c\u01A1 th\u1EC3 sinh v\u1EADt n\xE0y kh\xF4ng bao gi\u1EDD ti\xEAu
    t\xE1n, bu\u1ED9c n\xF3 ph\u1EA3i lu\xF4n trong tr\u1EA1ng th\xE1i hung h\u0103ng.
    Th\u1EE9 c\xF2n l\u1EA1i kh\xF4ng gi\u1ED1ng \u0111\u1ED9ng v\u1EADt c\u0169ng
    kh\xF4ng gi\u1ED1ng m\xE1y m\xF3c, m\xE0 l\xE0 m\u1ED9t l\xF2 l\u1EEDa s\u1ED1ng
    \u0111\u01B0\u1EE3c \u0111i\u1EC1u khi\u1EC3n b\u1EDFi b\u1EA3n n\u0103ng."
