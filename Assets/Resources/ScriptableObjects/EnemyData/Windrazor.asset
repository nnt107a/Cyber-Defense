  m_Name: Windrazor
  m_EditorClassIdentifier: Assembly-CSharp::EnemyData
  enemyPrefab: {fileID: 7624256713184337812, guid: 9bda1447b98143f4fbc90cd0552e9c43, type: 3}
  enemyIcon: {fileID: 21300000, guid: f930bb88c3ebf0f4fbf4d227ce484093, type: 3}
  enemyName: Windrazor
  maxHealth: 90
  moveSpeed: 1.2
  attackDamage: 40
  attackSpeed: 1
  physicalResistance: 0.1
  magicalResistance: 0.1
  eCoreDrop: 50
  description: "Windrazor evolved from airborne microorganisms used in atmospheric
    filtration systems. Energy surges altered their cellular structure, granting
    them razor-sharp motion control. They hunt by riding pressure waves, slicing
    targets before they can react. Their presence marks areas where the lab\u2019s
    air systems completely collapsed."
  vnDescription: "Windrazor ti\u1EBFn h\xF3a t\u1EEB c\xE1c vi sinh v\u1EADt trong
    kh\xF4ng kh\xED \u0111\u01B0\u1EE3c s\u1EED d\u1EE5ng trong h\u1EC7 th\u1ED1ng
    l\u1ECDc kh\xED quy\u1EC3n. S\u1EF1 t\u0103ng \u0111\u1ED9t bi\u1EBFn n\u0103ng
    l\u01B0\u1EE3ng \u0111\xE3 l\xE0m thay \u0111\u1ED5i c\u1EA5u tr\xFAc t\u1EBF
    b\xE0o c\u1EE7a ch\xFAng, gi\xFAp ch\xFAng c\xF3 kh\u1EA3 n\u0103ng \u0111i\u1EC1u
    khi\u1EC3n chuy\u1EC3n \u0111\u1ED9ng s\u1EAFc b\xE9n nh\u01B0 dao c\u1EA1o.
    Ch\xFAng s\u0103n m\u1ED3i b\u1EB1ng c\xE1ch c\u01B0\u1EE1i tr\xEAn s\xF3ng \xE1p
    su\u1EA5t, c\u1EAFt xuy\xEAn m\u1EE5c ti\xEAu tr\u01B0\u1EDBc khi ch\xFAng k\u1ECBp
    ph\u1EA3n \u1EE9ng. S\u1EF1 hi\u1EC7n di\u1EC7n c\u1EE7a ch\xFAng \u0111\xE1nh
    d\u1EA5u nh\u1EEFng khu v\u1EF1c m\xE0 h\u1EC7 th\u1ED1ng kh\xF4ng kh\xED c\u1EE7a
    ph\xF2ng th\xED nghi\u1EC7m \u0111\xE3 b\u1ECB s\u1EE5p \u0111\u1ED5 ho\xE0n
    to\xE0n."
