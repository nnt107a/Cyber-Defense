  enemyPrefab: {fileID: 796101051078232427, guid: 6c3fa2c80ffaec148b3768a1ed1b28d4, type: 3}
  enemyIcon: {fileID: 21300000, guid: 0a6a3c51e82215e489149e1c2740ea7b, type: 3}
  enemyName: Gloomslime
  maxHealth: 100
  moveSpeed: 0.8
  attackDamage: 40
  attackSpeed: 1
  physicalResistance: 0.1
  magicalResistance: 0.1
  eCoreDrop: 50
  description: "Gloomslime began as a synthetic microorganism meant to absorb radiation
    safely. Instead, it adapted\u2014developing collective intelligence across its
    amorphous body. Prolonged exposure to darkness and energy flux caused it to produce
    hallucinogenic emissions. Scientists fear Gloomslime is still evolving, learning
    from every encounter."
  vnDescription: "Gloomslime ban \u0111\u1EA7u l\xE0 m\u1ED9t vi sinh v\u1EADt t\u1ED5ng
    h\u1EE3p \u0111\u01B0\u1EE3c t\u1EA1o ra \u0111\u1EC3 h\u1EA5p th\u1EE5 b\u1EE9c
    x\u1EA1 m\u1ED9t c\xE1ch an to\xE0n. Thay v\xE0o \u0111\xF3, n\xF3 \u0111\xE3
    th\xEDch nghi \u2013 ph\xE1t tri\u1EC3n tr\xED tu\u1EC7 t\u1EADp th\u1EC3 tr\xEAn
    to\xE0n b\u1ED9 c\u01A1 th\u1EC3 v\xF4 \u0111\u1ECBnh h\xECnh c\u1EE7a m\xECnh.
    Ti\u1EBFp x\xFAc l\xE2u d\xE0i v\u1EDBi b\xF3ng t\u1ED1i v\xE0 d\xF2ng n\u0103ng
    l\u01B0\u1EE3ng khi\u1EBFn n\xF3 t\u1EA1o ra c\xE1c ch\u1EA5t ph\xE1t quang g\xE2y
    \u1EA3o gi\xE1c. C\xE1c nh\xE0 khoa h\u1ECDc lo ng\u1EA1i Gloomslime v\u1EABn
    \u0111ang ti\u1EBFn h\xF3a, h\u1ECDc h\u1ECFi t\u1EEB m\u1ECDi cu\u1ED9c g\u1EB7p
    g\u1EE1."
